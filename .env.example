ETHERSCAN_API_KEY=
GOPLUS_API_KEY=
GOPLUS_API_SECRET=
# Optional; default 1. Set 0 to skip NodeReal and use other fallbacks.
ENABLE_NODEREAL=1
# Optional NodeReal key; shared starter key is otherwise used for BSC/ETH.
NODEREAL_API_KEY=
# Optional already-minted GoPlus access token; usually leave blank.
GOPLUS_ACCESS_TOKEN=
DEEPSEEK_API_KEY=

# Optional GitHub personal access token. Improves API quota for frontier.py github.
GITHUB_TOKEN=

# Optional read-only JSON-RPC endpoints for recently mined contract creations.
# Set only the chain(s) you intend to scan; never commit real endpoint URLs here.
ETH_RPC_URL=
BSC_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
POLYGON_RPC_URL=
OPTIMISM_RPC_URL=

# Optional WebSocket JSON-RPC endpoints for provider-visible pending creations.
# This sees only that provider's mempool, not a global network-wide mempool.
ETH_RPC_WS_URL=
BSC_RPC_WS_URL=
BASE_RPC_WS_URL=
ARBITRUM_RPC_WS_URL=
POLYGON_RPC_WS_URL=
OPTIMISM_RPC_WS_URL=
